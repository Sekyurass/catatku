# ---- Database (Supabase) ----
# Supabase Dashboard > Project Settings > Database > Connection string.
# DATABASE_URL: Transaction pooler (port 6543) untuk runtime aplikasi.
# connect_timeout/pool_timeout otomatis ditambahkan API bila tidak ditulis (15/20 detik).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# DIRECT_URL: Session pooler (port 5432) untuk migrasi Prisma.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Database tes: skema terpisah agar tes tidak menyentuh data dev.
# Pakai session pooler (port 5432) dengan ?schema=catatku_test.
TEST_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=catatku_test"

# Alternatif lokal (docker compose up db):
# DATABASE_URL="postgresql://catatku:catatku@localhost:5433/catatku"
# DIRECT_URL="postgresql://catatku:catatku@localhost:5433/catatku"
# TEST_DATABASE_URL="postgresql://catatku:catatku@localhost:5433/catatku?schema=catatku_test"

# ---- Server ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Asal (origin) frontend yang diizinkan, pisahkan dengan koma.
CORS_ORIGINS=http://localhost:5173
# Jumlah proxy di depan API (0 = langsung). Penting untuk rate limit per IP.
TRUST_PROXY=0

# ---- Auth ----
# Minimal 32 karakter acak. Contoh: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=ganti-dengan-string-acak-minimal-32-karakter
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Wajib >= 12 di production.
BCRYPT_COST=12
# Maksimal percobaan login/daftar per IP per 15 menit.
AUTH_RATE_LIMIT=20

# ---- Email (lupa kata sandi) ----
# Alamat aplikasi web untuk tautan di email. Kosong = origin CORS pertama.
APP_URL=
# Kosong = email tidak dikirim; saat development isinya (termasuk tautan) dicetak di log API.
# Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true, SMTP_PASS = App Password (bukan sandi akun).
# Brevo: smtp-relay.brevo.com, port 587, SMTP_SECURE=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Catatku <no-reply@catatku.local>"
RESET_TOKEN_TTL_MINUTES=30

# ---- Notifikasi push (Web Push / VAPID) ----
# Kosong = push mati; lonceng & pengingat di aplikasi tetap jalan.
# Buat sepasang kunci sekali saja: npx web-push generate-vapid-keys
# Jangan diganti setelah ada pengguna yang berlangganan (langganan lama jadi tidak valid).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontak untuk layanan push: mailto:… atau https://…
VAPID_SUBJECT=mailto:admin@catatku.local

# ---- Penjadwal (transaksi berulang & pengingat) ----
# Jalan di dalam proses API: sekali saat start, pengingat tiap jam tepat, transaksi berulang tiap jam menit ke-5 (WIB).
# Bila API dijalankan lebih dari satu instance, aktifkan di satu instance saja (aman bila ganda, tapi boros).
SCHEDULER_ENABLED=true

# ---- Lampiran foto struk (object storage, protokol S3) ----
# Kosong semua = lampiran mati (flag "attachments" otomatis false). Isi semua atau tidak sama sekali.
# Supabase: Storage > buat bucket PRIVAT (mis. "lampiran") > Storage Settings > S3 protocol > New access key.
# Cloudflare R2: endpoint https://<account-id>.r2.cloudflarestorage.com, region "auto".
# Kunci ini melewati RLS: hanya untuk server, jangan pernah di-commit atau dikirim ke browser.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# ---- Email bank masuk (flag "bank_email") ----
# Kosong = hanya unggah .eml. Alamat pengguna jadi <lokal>+<token>@<domain> dari alamat dasar ini.
INBOUND_EMAIL_ADDRESS=
# Rahasia webhook POST /api/v1/inbound/* (>= 24 karakter acak). Jangan di-commit.
INBOUND_EMAIL_SECRET=
# Alternatif webhook: baca kotak masuk lewat IMAP tiap 2 menit (mis. Gmail khusus + App password).
INBOUND_IMAP_HOST=
INBOUND_IMAP_PORT=993
INBOUND_IMAP_USER=
INBOUND_IMAP_PASS=
DNS_FALLBACK_SERVERS=1.1.1.1,8.8.8.8

# ---- Feature flags ----
# Paksa nilai flag tanpa menyentuh DB, mis. "recurring_transactions:on,templates:off"
FEATURE_FLAGS_FORCE=
