generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plan {
  FREE
  PREMIUM
}

enum WalletType {
  CASH
  BANK
  EWALLET
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  /// Fase 4.3: uang pinjaman & pembayarannya. Mengubah saldo dompet, tidak masuk laporan/anggaran.
  DEBT
}

/// PAYABLE = utang (pengguna meminjam), RECEIVABLE = piutang (pengguna meminjamkan).
enum DebtDirection {
  PAYABLE
  RECEIVABLE
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum OccurrenceStatus {
  PENDING
  POSTED
  SKIPPED
}

enum NotificationType {
  REMINDER
  RECURRING_PENDING
  RECURRING_POSTED
  BANK_EMAIL
  DEBT_DUE
}

enum InboundTransactionStatus {
  PENDING
  CONFIRMED
  DISMISSED
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED
  ROLLED_BACK
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  plan            Plan      @default(FREE)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// null = belum ada foto profil. Juga dipakai klien sebagai versi cache foto.
  avatarUpdatedAt DateTime?
  /// Opt-in: kalimat ketik cepat yang dikoreksi boleh disimpan (tanpa identitas) sebagai dataset.
  shareQuickText  Boolean   @default(false)
  /// Persetujuan Kebijakan Privasi terakhir (PRIVACY_POLICY_VERSION); null = belum pernah.
  privacyVersion  String?
  privacyAgreedAt DateTime?
  /// Salah satu TIME_ZONES (WIB/WITA/WIT): "hari ini", bulan berjalan, dan jam pengingat.
  timeZone        String    @default("Asia/Jakarta")

  avatar              UserAvatar?
  wallets             Wallet[]
  categories          Category[]
  transactions        Transaction[]
  budgets             Budget[]
  refreshTokens       RefreshToken[]
  resetTokens         PasswordResetToken[]
  idempotencyKeys     IdempotencyKey[]
  events              AnalyticsEvent[]
  recurringRules      RecurringRule[]
  occurrences         RecurringOccurrence[]
  templates           TransactionTemplate[]
  importBatches       ImportBatch[]
  notifications       Notification[]
  notificationSetting NotificationSetting?
  pushSubscriptions   PushSubscription[]
  categoryMaps        MerchantCategoryMap[]
  tags                Tag[]
  attachments         Attachment[]
  savingsGoals        SavingsGoal[]
  goalContributions   GoalContribution[]
  insightDismissals   InsightDismissal[]
  emailInbox          EmailInbox?
  inboundTransactions InboundTransaction[]
  debts               Debt[]
  debtPayments        DebtPayment[]
}

/// Tautan "lupa kata sandi": sekali pakai, umur pendek, hanya hash yang disimpan.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Byte foto profil dipisah dari User agar query User biasa tidak ikut memuat gambar.
model UserAvatar {
  userId    String   @id
  mimeType  String
  data      Bytes
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 dari token mentah; token mentah hanya ada di cookie klien.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wallet {
  id             String     @id @default(cuid())
  userId         String
  name           String
  type           WalletType
  /// Rupiah utuh. Saldo berjalan dihitung: initialBalance + SUM(transaksi aktif).
  initialBalance BigInt     @default(0)
  color          String     @default("#0F766E")
  archivedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  recurringRules RecurringRule[]
  templates      TransactionTemplate[]
  importBatches  ImportBatch[]
  savingsGoals   SavingsGoal[]
  debts          Debt[]
  debtPayments   DebtPayment[]

  @@index([userId])
}

model Category {
  id         String       @id @default(cuid())
  /// null = kategori default milik sistem, dipakai bersama semua pengguna.
  userId     String?
  name       String
  type       CategoryType
  icon       String
  color      String
  archivedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user           User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  budgets        Budget[]
  recurringRules RecurringRule[]
  templates      TransactionTemplate[]
  merchantMaps   MerchantCategoryMap[]

  @@index([userId])
}

/// Kategori terakhir yang dipilih pengguna untuk suatu catatan/nama toko (Fase 3.2).
/// Kunci = merchantKey(note); diperbarui setiap transaksi disimpan, jadi koreksi langsung dipelajari.
model MerchantCategoryMap {
  id         String       @id @default(cuid())
  userId     String
  type       CategoryType
  key        String
  categoryId String
  hits       Int          @default(1)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, type, key])
  @@index([userId, updatedAt(sort: Desc)])
}

model Transaction {
  id              String          @id @default(cuid())
  userId          String
  walletId        String
  categoryId      String?
  type            TransactionType
  /// Rupiah utuh, BERTANDA sesuai arah uang terhadap dompet.
  amount          BigInt
  date            DateTime        @db.Date
  note            String?
  /// Dua baris transfer berbagi nilai yang sama.
  transferGroupId String?
  /// Diisi bila dibuat oleh aturan berulang. Aturan dihapus -> null, transaksinya tetap ada.
  recurringRuleId String?
  /// Diisi bila berasal dari impor CSV; membatalkan impor menghapus semua transaksinya.
  importBatchId   String?
  /// Transaksi bertipe DEBT: uang pinjaman awal atau pembayaran utang/piutang ini.
  debtId          String?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        Wallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringRule RecurringRule?   @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  importBatch   ImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  debt          Debt?            @relation(fields: [debtId], references: [id], onDelete: SetNull)
  tags          TransactionTag[]
  attachments   Attachment[]

  @@index([userId, date(sort: Desc), createdAt(sort: Desc)])
  @@index([userId, walletId])
  @@index([userId, categoryId])
  @@index([transferGroupId])
  @@index([recurringRuleId])
  @@index([importBatchId])
  @@index([debtId])
}

/// Fase 2.5. Label bebas milik pengguna; satu transaksi bisa punya banyak tag.
/// `key` = nama dinormalisasi (huruf kecil, spasi tunggal) agar "Liburan" dan "liburan" tidak ganda.
model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  key       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@unique([userId, key])
}

model TransactionTag {
  transactionId String
  tagId         String
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
}

/// Fase 2.5. Foto lampiran; berkasnya di penyimpanan objek (S3-compatible), di sini hanya metadata.
/// Transaksi terhapus permanen -> transactionId null, lalu berkas + baris dibersihkan oleh job.
model Attachment {
  id            String   @id @default(cuid())
  userId        String
  transactionId String?
  storageKey    String   @unique
  mimeType      String
  size          Int
  createdAt     DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([userId])
}

/// Fase 1.4. Satu kali impor CSV ke satu dompet.
model ImportBatch {
  id           String       @id @default(cuid())
  userId       String
  walletId     String
  filename     String
  /// null = CSV biasa; "bca" = mutasi bank (Fase 3.4).
  source       String?
  status       ImportStatus @default(PROCESSING)
  /// { total, imported, skipped, failed }
  stats        Json
  /// Baris yang dilewati/gagal beserta alasannya (maks. IMPORT_MAX_ISSUES).
  issues       Json         @default("[]")
  rolledBackAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet       Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, createdAt(sort: Desc)])
}

/// Fase 1.1. Jadwal dihitung dari startDate + indeks kejadian (lihat shared/recurrence.ts).
model RecurringRule {
  id         String              @id @default(cuid())
  userId     String
  walletId   String
  categoryId String
  type       TransactionType
  /// Rupiah utuh, selalu positif; tanda diberikan saat transaksi dibuat.
  amount     BigInt
  note       String?
  frequency  RecurrenceFrequency
  interval   Int                 @default(1)
  startDate  DateTime            @db.Date
  endDate    DateTime?           @db.Date
  autoPost   Boolean             @default(true)
  /// Indeks kejadian berikutnya yang belum diproses (0 = startDate).
  nextIndex  Int                 @default(0)
  /// Tanggal kejadian ke-nextIndex; null = jadwal sudah melewati endDate.
  nextRunAt  DateTime?           @db.Date
  pausedAt   DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet       Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  category     Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  occurrences  RecurringOccurrence[]
  transactions Transaction[]

  @@index([userId])
  @@index([nextRunAt])
}

/// Fase 1.3. Chip "Cepat catat"; `name` juga menjadi catatan transaksi yang dibuat darinya.
model TransactionTemplate {
  id         String          @id @default(cuid())
  userId     String
  walletId   String
  categoryId String
  type       TransactionType
  name       String
  /// Rupiah utuh, selalu positif. null = nominal diisi setiap kali dipakai.
  amount     BigInt?
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet   Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
}

/// Fase 2.1. Target tabungan; progres = jumlah setoran (lihat GoalContribution).
model SavingsGoal {
  id           String    @id @default(cuid())
  userId       String
  name         String
  /// Rupiah utuh, positif.
  targetAmount BigInt
  deadline     DateTime? @db.Date
  icon         String
  color        String
  /// Dompet tabungan; bila diisi, setor/tarik dicatat sebagai transfer ke/dari dompet ini.
  walletId     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        Wallet?            @relation(fields: [walletId], references: [id], onDelete: SetNull)
  contributions GoalContribution[]

  @@index([userId])
}

/// Setoran (+) atau penarikan (−) ke target. Bila `transferGroupId` diisi, nominal dan tanggal
/// mengikuti transfernya, dan setoran tidak dihitung selama transfer itu terhapus.
model GoalContribution {
  id              String   @id @default(cuid())
  goalId          String
  userId          String
  /// Rupiah utuh, BERTANDA: + setor, − tarik.
  amount          BigInt
  date            DateTime @db.Date
  note            String?
  transferGroupId String?
  createdAt       DateTime @default(now())

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId, date(sort: Desc)])
  @@index([userId])
  @@index([transferGroupId])
}

/// Fase 4.3. Total kewajiban = principal + interest; sisa = total − Σ pembayaran.
/// Jadwal cicilan tidak disimpan: dihitung dari installments + firstDueDate (shared/debt.ts).
model Debt {
  id           String        @id @default(cuid())
  userId       String
  direction    DebtDirection
  /// Dengan siapa (orang, bank, leasing).
  counterparty String
  /// Rupiah utuh, positif.
  principal    BigInt
  /// Total bunga/biaya selama tenor (0 = tanpa bunga), dibagi rata ke setiap cicilan.
  interest     BigInt        @default(0)
  startDate    DateTime      @db.Date
  /// Jatuh tempo pelunasan sekaligus (tanpa cicilan); null = tanpa jatuh tempo.
  dueDate      DateTime?     @db.Date
  /// Jumlah cicilan bulanan; null = dibayar sekaligus/bebas.
  installments Int?
  firstDueDate DateTime?     @db.Date
  note         String?
  /// Dompet tempat uang pinjaman masuk/keluar saat dicatat; null = tidak dicatat di dompet.
  walletId     String?
  /// Diisi saat sisa mencapai 0; dikosongkan lagi bila pembayaran dihapus.
  settledAt    DateTime?
  /// Pengingat terakhir yang dikirim ("<indeks cicilan>:soon|overdue"), agar tidak berulang.
  lastReminder String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet       Wallet?       @relation(fields: [walletId], references: [id], onDelete: SetNull)
  payments     DebtPayment[]
  transactions Transaction[]

  @@index([userId, settledAt])
}

model DebtPayment {
  id            String   @id @default(cuid())
  debtId        String
  userId        String
  /// Rupiah utuh, positif.
  amount        BigInt
  date          DateTime @db.Date
  note          String?
  walletId      String?
  /// Transaksi DEBT di dompet; null bila pembayaran tidak dicatat di dompet.
  transactionId String?  @unique
  createdAt     DateTime @default(now())

  debt   Debt    @relation(fields: [debtId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@index([debtId, date(sort: Desc)])
  @@index([userId])
}

/// Satu baris per (aturan, tanggal): kunci idempotensi scheduler sekaligus antrean konfirmasi.
model RecurringOccurrence {
  id            String           @id @default(cuid())
  ruleId        String
  userId        String
  date          DateTime         @db.Date
  status        OccurrenceStatus
  transactionId String?          @unique
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  rule RecurringRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ruleId, date])
  @@index([userId, status])
}

model Budget {
  id          String @id @default(cuid())
  userId      String
  categoryId  String
  /// Format YYYY-MM.
  month       String @db.Char(7)
  limitAmount BigInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
  @@index([userId, month])
}

/// Isi lonceng notifikasi. dedupeKey membuat pembuatan notifikasi idempoten (mis. "reminder:2026-10-07").
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Pengaturan pengingat harian; baris dibuat saat pertama kali dibaca/diubah.
model NotificationSetting {
  userId           String    @id
  reminderEnabled  Boolean   @default(false)
  /// Jam lokal di zona waktu pengguna (User.timeZone), 5–23.
  reminderHour     Int       @default(20)
  /// 0 = Minggu … 6 = Sabtu.
  reminderDays     Int[]     @default([0, 1, 2, 3, 4, 5, 6])
  /// Hari terakhir pengingat diperiksa; menjamin maksimal satu pengingat per hari.
  lastReminderDate DateTime? @db.Date
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reminderEnabled, reminderHour])
}

/// Satu baris per browser/perangkat yang mengizinkan notifikasi push.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Insight yang ditutup pengguna. insightId sudah memuat periodenya (mis. bulan), jadi insight
/// serupa di periode berikutnya tetap muncul.
model InsightDismissal {
  id          String   @id @default(cuid())
  userId      String
  insightId   String
  dismissedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, insightId])
}

/// Dataset ketikan cepat dari pengguna yang ikut (User.shareQuickText). Sengaja TANPA userId dan
/// tanpa jam agar tidak bisa dikaitkan ke akun; nomor HP/rekening & email sudah disamarkan.
/// Dihapus otomatis setelah expiresAt.
model QuickTextSample {
  id        String   @id @default(cuid())
  text      String
  /// Hasil parser: { type, amount, dateOffset, wallet, toWallet, category, note }.
  parsed    Json
  /// Nilai yang akhirnya disimpan pengguna, bentuknya sama dengan parsed.
  final     Json
  /// Isian yang berbeda antara parsed dan final, mis. ["amount", "category"].
  corrected String[]
  createdOn DateTime @db.Date
  expiresAt DateTime @db.Date

  @@index([expiresAt])
}

/// Kotak masuk "catat dari email bank". Alamatnya = INBOUND_EMAIL_ADDRESS dengan +token
/// (mis. catatku.masuk+abc123@gmail.com); token acak, bisa diganti bila alamat bocor.
model EmailInbox {
  userId           String    @id
  token            String    @unique
  enabled          Boolean   @default(true)
  walletId         String?
  /// Gmail yang meminta penerusan ke alamat ini, dari email konfirmasi Google (bertanda tangan DKIM).
  sourceEmail      String?
  forwardingCode   String?
  forwardingCodeAt DateTime?
  lastReceivedAt   DateTime?
  /// Salah satu BANK_EMAIL_RESULTS.
  lastResult       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Transaksi yang dibaca dari email bank; baru menjadi Transaction setelah dikonfirmasi pengguna.
/// Isi email tidak disimpan, hanya hasil bacaannya.
model InboundTransaction {
  id            String                   @id @default(cuid())
  userId        String
  /// "bca" atau domain pengirim untuk pembaca umum.
  source        String
  kind          String
  /// Nomor referensi bank; tanpa itu Message-ID / hash email. Kunci anti-ganda.
  reference     String
  status        InboundTransactionStatus @default(PENDING)
  type          TransactionType
  /// Rupiah utuh, positif, sudah termasuk biaya.
  amount        BigInt
  fee           BigInt                   @default(0)
  date          DateTime                 @db.Date
  time          String?                  @db.Char(5)
  counterparty  String?
  note          String
  accountHint   String?
  confident     Boolean                  @default(true)
  transactionId String?                  @unique
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, reference])
  @@index([userId, status, date(sort: Desc)])
}

/// Flag fitur fase berikutnya. plan null = semua paket; userIds = allowlist per pengguna.
model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  plan        Plan?
  userIds     String[] @default([])
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Menyimpan respons operasi tulis agar retry dengan kunci yang sama tidak membuat data ganda.
model IdempotencyKey {
  id           String   @id @default(cuid())
  userId       String
  key          String
  requestHash  String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([createdAt])
}

/// Event produk ringan tanpa data sensitif (tanpa nominal/catatan) untuk menilai gerbang fase.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String
  name      String
  props     Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([name, createdAt])
  @@index([userId, createdAt])
}
