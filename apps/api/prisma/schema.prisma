generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plan {
  FREE
  PREMIUM
}

enum WalletType {
  CASH
  BANK
  EWALLET
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum OccurrenceStatus {
  PENDING
  POSTED
  SKIPPED
}

enum NotificationType {
  REMINDER
  RECURRING_PENDING
  RECURRING_POSTED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  plan            Plan      @default(FREE)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  /// null = belum ada foto profil. Juga dipakai klien sebagai versi cache foto.
  avatarUpdatedAt DateTime?

  avatar              UserAvatar?
  wallets             Wallet[]
  categories          Category[]
  transactions        Transaction[]
  budgets             Budget[]
  refreshTokens       RefreshToken[]
  resetTokens         PasswordResetToken[]
  idempotencyKeys     IdempotencyKey[]
  events              AnalyticsEvent[]
  recurringRules      RecurringRule[]
  occurrences         RecurringOccurrence[]
  templates           TransactionTemplate[]
  notifications       Notification[]
  notificationSetting NotificationSetting?
  pushSubscriptions   PushSubscription[]
}

/// Tautan "lupa kata sandi": sekali pakai, umur pendek, hanya hash yang disimpan.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Byte foto profil dipisah dari User agar query User biasa tidak ikut memuat gambar.
model UserAvatar {
  userId    String   @id
  mimeType  String
  data      Bytes
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 dari token mentah; token mentah hanya ada di cookie klien.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wallet {
  id             String     @id @default(cuid())
  userId         String
  name           String
  type           WalletType
  /// Rupiah utuh. Saldo berjalan dihitung: initialBalance + SUM(transaksi aktif).
  initialBalance BigInt     @default(0)
  color          String     @default("#0F766E")
  archivedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  recurringRules RecurringRule[]
  templates      TransactionTemplate[]

  @@index([userId])
}

model Category {
  id         String       @id @default(cuid())
  /// null = kategori default milik sistem, dipakai bersama semua pengguna.
  userId     String?
  name       String
  type       CategoryType
  icon       String
  color      String
  archivedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user           User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  budgets        Budget[]
  recurringRules RecurringRule[]
  templates      TransactionTemplate[]

  @@index([userId])
}

model Transaction {
  id              String          @id @default(cuid())
  userId          String
  walletId        String
  categoryId      String?
  type            TransactionType
  /// Rupiah utuh, BERTANDA sesuai arah uang terhadap dompet.
  amount          BigInt
  date            DateTime        @db.Date
  note            String?
  /// Dua baris transfer berbagi nilai yang sama.
  transferGroupId String?
  /// Diisi bila dibuat oleh aturan berulang. Aturan dihapus -> null, transaksinya tetap ada.
  recurringRuleId String?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        Wallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringRule RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)

  @@index([userId, date(sort: Desc), createdAt(sort: Desc)])
  @@index([userId, walletId])
  @@index([userId, categoryId])
  @@index([transferGroupId])
  @@index([recurringRuleId])
}

/// Fase 1.1. Jadwal dihitung dari startDate + indeks kejadian (lihat shared/recurrence.ts).
model RecurringRule {
  id         String              @id @default(cuid())
  userId     String
  walletId   String
  categoryId String
  type       TransactionType
  /// Rupiah utuh, selalu positif; tanda diberikan saat transaksi dibuat.
  amount     BigInt
  note       String?
  frequency  RecurrenceFrequency
  interval   Int                 @default(1)
  startDate  DateTime            @db.Date
  endDate    DateTime?           @db.Date
  autoPost   Boolean             @default(true)
  /// Indeks kejadian berikutnya yang belum diproses (0 = startDate).
  nextIndex  Int                 @default(0)
  /// Tanggal kejadian ke-nextIndex; null = jadwal sudah melewati endDate.
  nextRunAt  DateTime?           @db.Date
  pausedAt   DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet       Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  category     Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  occurrences  RecurringOccurrence[]
  transactions Transaction[]

  @@index([userId])
  @@index([nextRunAt])
}

/// Fase 1.3. Chip "Cepat catat"; `name` juga menjadi catatan transaksi yang dibuat darinya.
model TransactionTemplate {
  id         String          @id @default(cuid())
  userId     String
  walletId   String
  categoryId String
  type       TransactionType
  name       String
  /// Rupiah utuh, selalu positif. null = nominal diisi setiap kali dipakai.
  amount     BigInt?
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet   Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
}

/// Satu baris per (aturan, tanggal): kunci idempotensi scheduler sekaligus antrean konfirmasi.
model RecurringOccurrence {
  id            String           @id @default(cuid())
  ruleId        String
  userId        String
  date          DateTime         @db.Date
  status        OccurrenceStatus
  transactionId String?          @unique
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  rule RecurringRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ruleId, date])
  @@index([userId, status])
}

model Budget {
  id          String @id @default(cuid())
  userId      String
  categoryId  String
  /// Format YYYY-MM.
  month       String @db.Char(7)
  limitAmount BigInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
  @@index([userId, month])
}

/// Isi lonceng notifikasi. dedupeKey membuat pembuatan notifikasi idempoten (mis. "reminder:2026-10-07").
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Pengaturan pengingat harian; baris dibuat saat pertama kali dibaca/diubah.
model NotificationSetting {
  userId           String    @id
  reminderEnabled  Boolean   @default(false)
  /// Jam lokal APP_TIME_ZONE (WIB), 5–23.
  reminderHour     Int       @default(20)
  /// 0 = Minggu … 6 = Sabtu.
  reminderDays     Int[]     @default([0, 1, 2, 3, 4, 5, 6])
  /// Hari terakhir pengingat diperiksa; menjamin maksimal satu pengingat per hari.
  lastReminderDate DateTime? @db.Date
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reminderEnabled, reminderHour])
}

/// Satu baris per browser/perangkat yang mengizinkan notifikasi push.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Flag fitur fase berikutnya. plan null = semua paket; userIds = allowlist per pengguna.
model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  plan        Plan?
  userIds     String[] @default([])
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Menyimpan respons operasi tulis agar retry dengan kunci yang sama tidak membuat data ganda.
model IdempotencyKey {
  id           String   @id @default(cuid())
  userId       String
  key          String
  requestHash  String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([createdAt])
}

/// Event produk ringan tanpa data sensitif (tanpa nominal/catatan) untuk menilai gerbang fase.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String
  name      String
  props     Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([name, createdAt])
  @@index([userId, createdAt])
}
